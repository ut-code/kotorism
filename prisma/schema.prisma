// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// My単語帳 1冊分（Excelから取り込んだ、または手動作成した単語帳）

model Notebook {
  id        String   @id @default(cuid())
  title     String
  // Excelの1行目（ヘッダー）に対応する列名を、出現順のまま保存する
  columns   Json
  // trueの間、/share/[id] からログイン無しで閲覧できる
  isPublic  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
  shares    NotebookShare[]
  invites   NotebookInvite[]

  @@index([userId])

  @@map("notebooks")
}

// 単語帳の共同編集者（招待リンク経由で参加したユーザー）。カード・列の追加/編集/削除が可能。
// 閲覧のみの共有は別途 Notebook.isPublic の公開リンク（ログイン不要）が担うため、
// ここでの共同編集者は常に編集可能（権限の区別を持たない）
model NotebookShare {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([notebookId, userId])
  @@index([userId])

  @@map("notebook_shares")
}

// 単語帳作成者が発行する、編集可能な共同編集者への招待リンク。トークンを知っていてログイン済みなら
// 誰でも開いてNotebookShareとして参加できる。作成者はいつでも個別に失効（削除）できる
model NotebookInvite {
  id         String   @id @default(cuid())
  token      String   @unique @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([notebookId])

  @@map("notebook_invites")
}

// 単語帳内の1単語（1行）分のデータ

model Card {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  // { [列名]: セルの値 } の形で、その行の全列を保持する
  data       Json
  // Notebook.columns で先頭に来る列を「表」、次を「裏」として暗記学習モードに使う
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  progress   CardProgress[]

  @@index([notebookId, position])

  @@map("cards")
}

// 単語1件に対する、ユーザーごとの学習進捗。単語帳は共同編集者間で共有されるが、
// ★・表示回数はユーザーごとに独立させたいためCardではなくここで持つ
model CardProgress {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 現在★がついているか（復習抽出の対象になるかどうか）
  starred   Boolean  @default(false)
  // ★を付けた累計回数。付け外しを繰り返すほど増え、覚えにくさの目安になる
  starCount Int      @default(0)
  // 暗記学習モード（/study, /review）でこの単語がカードとして表示された累計回数
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([cardId, userId])
  @@index([userId, starred])

  @@map("card_progress")
}

model User {
  id                     String                  @id
  name                   String
  email                  String
  emailVerified          Boolean                 @default(false)
  username               String?
  displayUsername        String?
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  notebooks              Notebook[]
  notebookShares         NotebookShare[]
  cardProgress           CardProgress[]
  sectionProgress        SectionProgress[]
  essaySubmissions       EssaySubmission[]
  translationSubmissions TranslationSubmission[]

  @@unique([email])
  @@unique([username])

  @@map("users")
}

// 学習教材（/learn/[language]/[sectionSlug]）における、ユーザーごと・セクションごとの学習進捗。
// 「動詞の活用が苦手」「冠詞の一覧と縮約形が苦手」のように、セクション単位で苦手管理・復習日の提案を行う

model SectionProgress {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language    String
  // セクションのスラッグ（例: "01"）。app/learn/[language]/[sectionSlug] に対応する
  sectionSlug String

  // クイズ形式のセクション（例: 動詞活用ドリル）でのみ増える。読み物セクションでは常に0のまま
  attemptCount   Int       @default(0)
  correctCount   Int       @default(0)
  // Leitner式の箱番号（0〜6）。「正解」または「復習済みにする」操作のたび+1、誤答で0に戻る
  box            Int       @default(0)
  // クイズでの誤答による自動タグ。読み物セクションでは（誤答が存在しないため）常にfalseのまま
  autoTagged     Boolean   @default(false)
  // ユーザーが手動で付けたタグ。読み物セクションはこちらのみで苦手管理する
  manuallyTagged Boolean   @default(false)
  // 復習が必要かどうか（autoTagged・manuallyTaggedのいずれかがtrueならtrue）。一覧表示・絞り込みに使う
  needsReview    Boolean   @default(false)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, language, sectionSlug])
  @@index([userId, language, needsReview])

  @@map("section_progress")
}

// 作文セクション（/learn/essay/[language]）での1回分の提出・AI添削結果
model EssaySubmission {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language String

  // お題の種類。"preset"ならlib/essay/topics.tsの事前用意お題、"custom"ならユーザー自身が指定したお題
  topicSource     String
  // プリセットお題を選んだ場合の、lib/essay/topics.ts内での識別子。カスタムお題ではnull
  topicId         String?
  // 実際に使われたお題文（プリセットの複製、またはユーザーが入力したお題）。
  // プリセット内容が将来変わっても過去の提出時点の文言を保てるよう複製して保持する
  topicPrompt     String
  targetWordCount Int
  content         String

  // AIによる採点・添削結果。
  // { vocabulary: {max,score,comment}, grammar: {...}, structure: {...}, content: {...}, overallComment }
  feedback Json
  // 採点に使ったOpenRouterのモデルID（監査・不具合調査用）
  model    String

  createdAt DateTime @default(now())

  @@index([userId, language, createdAt])

  @@map("essay_submissions")
}

// 翻訳セクション（/learn/[language]/02）での1回分の提出・AI添削結果
model TranslationSubmission {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language String

  // 題材の種類。"preset"ならlib/translation/problems.tsの事前用意問題、"custom"ならユーザー自身が用意した原文
  problemSource        String  @default("preset")
  // 訳す方向。"fromJapanese"（和文→外国語）または"toJapanese"（外国語→和文）
  direction            String
  // プリセット問題を選んだ場合の、lib/translation/problems.ts内での識別子。カスタム題材ではnull
  problemId            String?
  // 出題時点の検定級（例: "仏検5級"）。プリセット内容が将来変わっても過去の提出時点の文言を保てるよう複製して保持する
  level                String
  // 出題時点の原文（同上の理由で複製して保持する）。カスタム題材ではユーザーが入力した原文
  sourceText           String
  // プリセット問題の模範解答（同上の理由で複製して保持する）。カスタム題材には模範解答が無いためnull
  referenceTranslation String?
  content              String

  // AIによる採点・添削結果。項目分けせず、総合点1つで採点する（作文セクションと異なる点）
  // { max, score, comment }
  feedback Json
  // 採点に使ったOpenRouterのモデルID（監査・不具合調査用）
  model    String

  createdAt DateTime @default(now())

  @@index([userId, language, createdAt])

  @@map("translation_submissions")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])

  @@map("sessions")
}

model Account {
  id                    String    @id
  // ログイン方法の種類（email/password なら "local:credential"）。
  // better-auth 1.7 以降、同一providerId内でaccountIdの一意性を保証するために追加されたフィールド
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])

  @@map("verifications")
}
