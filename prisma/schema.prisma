// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// My単語帳 1冊分（Excelから取り込んだ、または手動作成した単語帳）

model Notebook {
  id           String           @id @default(cuid())
  title        String
  // Excelの1行目（ヘッダー）に対応する列名を、出現順のまま保存する
  columns      Json
  // trueの間、/share/[id] からログイン無しで閲覧できる
  isPublic     Boolean          @default(false)
  // 作成者がお気に入りにしているか。My単語帳の一覧で、お気に入りを一番上にまとめて並べる
  favorite     Boolean          @default(false)
  // My単語帳の一覧での並び順（小さいほど上）。長押しで並べ替えると振り直す。
  // 同じ値どうし（並べ替える前の単語帳）は作成日の新しい順に並べる
  listPosition Int              @default(0)
  // 作成者が「学習済み」にしたか。My単語帳の一覧で、学習済みは一番下にまとめてグレーで並べる
  studied      Boolean          @default(false)
  // 単語の入力補助に使う言語（"french" / "german" / "spanish" / "chinese"）。null は指定なし（補助を出さない）
  language     String?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  cards        Card[]
  shares       NotebookShare[]
  invites      NotebookInvite[]
  views        NotebookView[]

  @@index([userId])
  @@map("notebooks")
}

// 単語帳の共同編集者（招待リンク経由で参加したユーザー）。カード・列の追加/編集/削除が可能。
// 閲覧のみの共有は別途 Notebook.isPublic の公開リンク（ログイン不要）が担うため、
// ここでの共同編集者は常に編集可能（権限の区別を持たない）
model NotebookShare {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([notebookId, userId])
  @@index([userId])
  @@map("notebook_shares")
}

// 単語帳作成者が発行する、編集可能な共同編集者への招待リンク。トークンを知っていてログイン済みなら
// 誰でも開いてNotebookShareとして参加できる。作成者はいつでも個別に失効（削除）できる
model NotebookInvite {
  id         String   @id @default(cuid())
  token      String   @unique @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([notebookId])
  @@map("notebook_invites")
}

// 単語帳内の1単語（1行）分のデータ

model Card {
  id         String         @id @default(cuid())
  notebookId String
  notebook   Notebook       @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  // { [列名]: セルの値 } の形で、その行の全列を保持する
  data       Json
  // Notebook.columns で先頭に来る列を「表」、次を「裏」として暗記学習モードに使う
  position   Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  progress   CardProgress[]

  @@index([notebookId, position])
  @@map("cards")
}

// 単語1件に対する、ユーザーごとの学習進捗。単語帳は共同編集者間で共有されるが、
// ★・表示回数はユーザーごとに独立させたいためCardではなくここで持つ
model CardProgress {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 現在★がついているか（復習抽出の対象になるかどうか）
  starred   Boolean  @default(false)
  // ★を付けた累計回数。付け外しを繰り返すほど増え、覚えにくさの目安になる
  starCount Int      @default(0)
  // 暗記学習モード（/study, /review）でこの単語がカードとして表示された累計回数
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([cardId, userId])
  @@index([userId, starred])
  @@map("card_progress")
}

model User {
  id                     String                  @id
  name                   String
  email                  String
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  notebooks              Notebook[]
  notebookShares         NotebookShare[]
  cardProgress           CardProgress[]
  sectionProgress        SectionProgress[]
  notebookViews          NotebookView[]
  sectionViews           SectionView[]
  essaySubmissions       EssaySubmission[]
  translationSubmissions TranslationSubmission[]
  studyEvents            StudyEvent[]
  studyDailyStats        StudyDailyStat[]
  studyTimeLogs          StudyTimeLog[]
  studyStreak            StudyStreak?

  @@unique([email])
  @@map("users")
}

// 学習教材（/learn/[language]/[sectionSlug]）における、ユーザーごと・セクションごとの学習進捗。
// 「動詞の活用が苦手」「冠詞の一覧と縮約形が苦手」のように、セクション単位で苦手管理・復習日の提案を行う

model SectionProgress {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language    String
  // セクションのスラッグ（例: "01"）。app/learn/[language]/[sectionSlug] に対応する
  sectionSlug String

  // クイズ形式のセクション（例: 動詞活用ドリル）でのみ増える。読み物セクションでは常に0のまま
  attemptCount   Int       @default(0)
  correctCount   Int       @default(0)
  // Leitner式の箱番号（0〜6）。「正解」または「復習済みにする」操作のたび+1、誤答で0に戻る
  box            Int       @default(0)
  // クイズでの誤答による自動タグ。読み物セクションでは（誤答が存在しないため）常にfalseのまま
  autoTagged     Boolean   @default(false)
  // ユーザーが手動で付けたタグ。読み物セクションはこちらのみで苦手管理する
  manuallyTagged Boolean   @default(false)
  // 復習が必要かどうか（autoTagged・manuallyTaggedのいずれかがtrueならtrue）。一覧表示・絞り込みに使う
  needsReview    Boolean   @default(false)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, language, sectionSlug])
  @@index([userId, language, needsReview])
  @@map("section_progress")
}

// 作文セクション（/learn/essay/[language]）での1回分の提出・AI添削結果
model EssaySubmission {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language String

  // お題の種類。"preset"ならapp/lib/shared/essay/topics.tsの事前用意お題、"custom"ならユーザー自身が指定したお題
  topicSource     String
  // プリセットお題を選んだ場合の、app/lib/shared/essay/topics.ts内での識別子。カスタムお題ではnull
  topicId         String?
  // 実際に使われたお題文（プリセットの複製、またはユーザーが入力したお題）。
  // プリセット内容が将来変わっても過去の提出時点の文言を保てるよう複製して保持する
  topicPrompt     String
  targetWordCount Int
  content         String

  // AIによる採点・添削結果。
  // { vocabulary: {max,score,comment}, grammar: {...}, structure: {...}, content: {...}, overallComment }
  feedback Json
  // 採点に使ったOpenRouterのモデルID（監査・不具合調査用）
  model    String

  createdAt DateTime @default(now())

  @@index([userId, language, createdAt])
  @@map("essay_submissions")
}

// 翻訳セクション（/learn/[language]/02）での1回分の提出・AI添削結果
model TranslationSubmission {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language String

  // 題材の種類。"preset"ならapp/lib/shared/translation/problems.tsの事前用意問題、"custom"ならユーザー自身が用意した原文
  problemSource        String  @default("preset")
  // 訳す方向。"fromJapanese"（和文→外国語）または"toJapanese"（外国語→和文）
  direction            String
  // プリセット問題を選んだ場合の、app/lib/shared/translation/problems.ts内での識別子。カスタム題材ではnull
  problemId            String?
  // 出題時点の原文。プリセット内容が将来変わっても過去の提出時点の文言を保てるよう複製して保持する。
  // カスタム題材ではユーザーが入力した原文
  sourceText           String
  // プリセット問題の模範解答（同上の理由で複製して保持する）。カスタム題材には模範解答が無いためnull
  referenceTranslation String?
  content              String

  // AIによる採点・添削結果。項目分けせず、総合点1つで採点する（作文セクションと異なる点）
  // { max, score, comment }
  feedback Json
  // 採点に使ったOpenRouterのモデルID（監査・不具合調査用）
  model    String

  createdAt DateTime @default(now())

  @@index([userId, language, createdAt])
  @@map("translation_submissions")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  // ログイン方法の種類（email/password なら "local:credential"）。
  // better-auth 1.7 以降、同一providerId内でaccountIdの一意性を保証するために追加されたフィールド
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ユーザーが単語帳を最後に開いた日時。トップページの「最近見た単語帳」に使う。
// 進捗（CardProgress）は学習操作をしたときだけ更新されるため、閲覧だけの履歴は別に持つ
model NotebookView {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId   String
  notebook     Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  lastViewedAt DateTime @default(now())

  @@unique([userId, notebookId])
  @@index([userId, lastViewedAt])
  @@map("notebook_views")
}

// ユーザーが学習ページ（/learn/[language]/[sectionSlug]）を最後に開いた日時。
// 読み物セクションのように進捗を操作しないページも履歴に残すため、SectionProgress とは別に持つ
model SectionView {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 言語スラッグ（例: "french"）
  language     String
  // セクションのスラッグ（例: "01"）
  sectionSlug  String
  lastViewedAt DateTime @default(now())

  @@unique([userId, language, sectionSlug])
  @@index([userId, lastViewedAt])
  @@map("section_views")
}

// 学習操作1回分のログ（カードの表示・クイズの回答・作文の提出など）。学習カレンダー（/history）で
// 日をクリックしたときの内訳表示に使う。単語帳やカードを削除しても過去の学習実績は残したいため、
// itemId・deckId には外部キーを張らない
model StudyEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime @default(now())
  // 操作の種類。lib/study-events.ts の STUDY_EVENT_TYPES のいずれか
  eventType  String
  // 操作の対象。カード系は Card.id、学習教材は sectionSlug、作文・翻訳は提出の id
  itemId     String
  // 単語帳での操作なら Notebook.id。学習教材・作文・翻訳では null
  deckId     String?
  // 学習教材・作文・翻訳での操作なら言語スラッグ（例: "french"）。単語帳は言語を持たないため null
  language   String?

  @@index([userId, occurredAt])
  @@map("study_events")
}

// StudyEvent の件数と StudyTimeLog の学習時間を「日本時間の日付 × 種類 × 単語帳 × 言語」ごとにまとめた集計。
// 学習カレンダーの過去12ヶ月分の表示を、ログ全件を読まずに出すために StudyEvent / StudyTimeLog と同時に更新する
model StudyDailyStat {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 日本時間での日付（"YYYY-MM-DD"）
  day       String
  eventType String
  // 一意キーに含めるため、該当しない場合は null ではなく空文字にする（SQLite の UNIQUE は NULL 同士を別物とみなす）
  deckId    String @default("")
  language  String @default("")
  count     Int    @default(0)
  // 学習時間（秒）。StudyTimeLog と同時に加算する
  seconds   Int    @default(0)

  @@unique([userId, day, eventType, deckId, language])
  @@index([userId, day])
  @@map("study_daily_stats")
}

// 学習ページ（暗記学習・クイズ・学習教材）を開いていた時間。ページを開くたびにブラウザ側で clientId を作り、
// 画面が表示されていて操作がある間の秒数を一定間隔で送って加算する。日付をまたいだら別の行にする
model StudyTimeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ページを開くたびにブラウザ側で作る識別子
  clientId  String
  // 日本時間での日付（"YYYY-MM-DD"）
  day       String
  // StudyEvent.eventType と同じ値（暗記学習なら "card_study"、学習教材のページなら "section_study"）
  eventType String
  // 単語帳なら Notebook.id、学習教材なら sectionSlug
  itemId    String
  deckId    String?
  language  String?
  seconds   Int      @default(0)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientId, day])
  @@index([userId, day])
  @@map("study_time_logs")
}

// 何日続けて学習しているか。学習を記録するたびに更新する（日の区切りは日本時間）
model StudyStreak {
  id               String @id @default(cuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 最後に学習した日（"YYYY-MM-DD"）までの連続日数。最後の学習が一昨日以前なら、表示上は途切れた（0日）扱い
  currentStreak    Int    @default(0)
  longestStreak    Int    @default(0)
  lastStudyDay     String
  // お祝いメッセージを表示済みの節目（10・20・30…）。連続が途切れたら0に戻す
  celebratedStreak Int    @default(0)

  @@map("study_streaks")
}

// 削除した単語帳の名前の控え。学習記録（StudyEvent など）は単語帳を削除しても残すが、
// 単語帳の名前は Notebook と一緒に消えてしまうため、学習カレンダーで元の名前を出せるよう削除時に残しておく
model DeletedNotebook {
  // 削除した単語帳の Notebook.id（学習記録の deckId と同じ値）
  id        String   @id
  title     String
  deletedAt DateTime @default(now())

  @@map("deleted_notebooks")
}
