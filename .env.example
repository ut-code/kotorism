DATABASE_URL="file:./prisma/dev.db"
# 本番(Coolify)ではSQLiteファイルを永続ボリュームに置き、そのパスを指定する:
# DATABASE_URL="file:/data/prod.db"

# Better Authがセッション/Cookieの署名に使う秘密鍵。`openssl rand -base64 32` などで生成する
BETTER_AUTH_SECRET=""
# アプリのオリジン。本番ではデプロイ先のURLに変更する
BETTER_AUTH_URL="http://localhost:3000"

# 作文セクションのAI添削（OpenRouter）で使うAPIキー。https://openrouter.ai/keys で発行する
OPENROUTER_API_KEY=""
# 省略時は lib/essay/grading.ts の無料モデルを使う。別の無料モデルに切り替えたい場合のみ指定する
# OPENROUTER_MODEL="google/gemma-4-31b-it:free"

# Google ログイン(OAuth)のクライアント。Google Cloud Console の「認証情報」で OAuth クライアント ID(ウェブ アプリケーション)を作り、
# 承認済みのリダイレクト URI に <BETTER_AUTH_URL>/api/auth/callback/google を登録する
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google を連携する前の既存ユーザーのため、移行期間中はユーザー名・パスワードでのログインを残す。期間が終わったら外す
PASSWORD_LOGIN="true"
