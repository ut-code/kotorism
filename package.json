{
  "name": "vocabook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "npx prisma migrate deploy && react-router-serve ./build/server/index.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "react-router typegen && tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mdx": "^2.0.14",
    "better-auth": "^1.7.2",
    "exceljs": "^4.4.0",
    "isbot": "^5.2.2",
    "pinyin": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.55.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.88.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
